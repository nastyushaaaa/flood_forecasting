# Формат файлов проекта, см. STYLEGUIDE.md, п. 1.1–1.2
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{csv,ipynb}]
insert_final_newline = unset
trim_trailing_whitespace = unset
